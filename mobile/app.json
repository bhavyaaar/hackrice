{
  "expo": {
    "name": "Northstar",
    "slug": "northstar",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "northstar",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1F18"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Northstar uses photos to scan your award letter.",
          "cameraPermission": "Northstar uses the camera to scan your award letter."
        }
      ],
      "expo-document-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Northstar uses the camera to scan financial aid documents."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.northstar.mobile"
    },
    "android": {
      "package": "app.northstar.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1F18"
      }
    }
  }
}
